 public void processClient() {
        try {
            String request;

            do {
                request = (String) in.readObject();

                switch (request) {

                    case "ADD":
                        // Wrap in a local try-catch to catch SQL errors and reply to client
                        try {
                            ParkingTicket ticket = (ParkingTicket) in.readObject();
                            dao.insertTicket(ticket);
                            
                            // Rubric requires replying exactly "OK"
                            out.writeObject("OK");
                            out.flush();
                        } catch (SQLException e) {
                            // Rubric requires replying with "ERROR: " and the message
                            out.writeObject("ERROR: " + e.getMessage());
                            out.flush();
                        }
                        break;

                    case "RETRIEVE": // Changed from "GET_ALL" to match rubric
                        List<ParkingTicket> tickets = dao.getAllTickets();
                        out.writeObject(tickets);
                        out.flush();
                        break;

                    case "EXIT":
                        out.writeObject("Goodbye!");
                        out.flush();
                        break;

                    default:
                        out.writeObject("Unknown request.");
                        out.flush();
                        break;
                }

            } while (!request.equals("EXIT"));

        } catch (EOFException e) {
            System.out.println("Client disconnected.");

        } catch (IOException | ClassNotFoundException e) {
            System.out.println("Communication error: " + e.getMessage());

        } finally {
            closeConnection();
        }
    }
